.idea/**/dataSources.ids
.idea/**/dataSources.xml
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml
.idea/

# IDEA Plugins
.idea/sonarlint
.idea/jarRepositories.xml
.idea/jpa-buddy-datasource.xml
